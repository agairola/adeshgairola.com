---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/global.css';
import { SEO } from 'astro-seo';
import buildInfo from '../build-info.json';
import {
	SITE_TITLE,
	LINKEDIN_URL,
	GITHUB_URL,
	SUBSTACK_URL,
	YOUTUBE_URL,
	RAXIT_URL,
	EMAIL,
} from '../consts';

interface Props {
	title: string;
	description: string;
	image?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
const { title, description, image = '/og-image.png' } = Astro.props;
const fullTitle = title === SITE_TITLE ? title : `${title} · ${SITE_TITLE}`;
const ogImageURL = new URL(image, Astro.site).toString();

const siteOrigin = Astro.site?.toString().replace(/\/$/, '') ?? '';
const PERSON_ID = `${siteOrigin}/#person`;
const ORG_ID = `${RAXIT_URL.replace(/\/$/, '')}/#org`;
const PROFILE_ID = `${siteOrigin}/#profile`;

// JSON-LD @graph: bundles Person + Organization + ProfilePage with cross-references.
// Helps AI answer engines (ChatGPT, Perplexity, Claude, Google AI Overviews) treat
// "Adesh Gairola" and "raxIT Labs" as durable entities rather than orphan strings.
const ldGraph = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'Person',
			'@id': PERSON_ID,
			name: 'Adesh Gairola',
			url: Astro.site?.toString(),
			image: ogImageURL,
			jobTitle: 'Founder',
			email: `mailto:${EMAIL}`,
			description,
			worksFor: { '@id': ORG_ID },
			address: {
				'@type': 'PostalAddress',
				addressLocality: 'Sydney',
				addressCountry: 'AU',
			},
			sameAs: [LINKEDIN_URL, GITHUB_URL, SUBSTACK_URL, YOUTUBE_URL],
			knowsAbout: [
				'AI Security',
				'Threat Modeling',
				'Cloud Security',
				'AI Agent Governance',
				'AWS Security',
				'Model Context Protocol',
				'OWASP LLM Top 10',
			],
		},
		{
			'@type': 'Organization',
			'@id': ORG_ID,
			name: 'raxIT Labs',
			url: RAXIT_URL,
			founder: { '@id': PERSON_ID },
			description:
				'AI security company working two directions: security for AI (governance, threat modeling, runtime guardrails for AI products in production) as the primary focus, and AI for security (using AI to automate threat modeling, detection, and compliance work) as the unusual sideline. Independent labs releasing open-source security tooling alongside the platform.',
			sameAs: ['https://www.linkedin.com/company/raxit-labs/'],
		},
		{
			'@type': 'ProfilePage',
			'@id': PROFILE_ID,
			url: canonicalURL,
			name: fullTitle,
			mainEntity: { '@id': PERSON_ID },
			about: { '@id': PERSON_ID },
			dateModified: buildInfo.builtAtISO,
			inLanguage: 'en-AU',
		},
	],
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="color-scheme" content="light dark" />
<meta name="format-detection" content="telephone=no" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="sitemap" href="/sitemap-index.xml" />
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />

<meta name="generator" content={Astro.generator} />

<SEO
	title={fullTitle}
	description={description}
	canonical={canonicalURL}
	openGraph={{
		basic: {
			title: fullTitle,
			type: 'website',
			image: ogImageURL,
			url: canonicalURL,
		},
		optional: {
			description,
			siteName: SITE_TITLE,
			locale: 'en_AU',
		},
	}}
	twitter={{
		card: 'summary_large_image',
		title: fullTitle,
		description,
		image: ogImageURL,
	}}
	extend={{
		meta: [
			{ name: 'author', content: 'Adesh Gairola' },
			{
				name: 'keywords',
				content:
					'AI security, threat modeling, cloud security, AI agents, raxIT Labs, Adesh Gairola',
			},
			{ name: 'robots', content: 'index, follow' },
		],
	}}
/>

<script is:inline type="application/ld+json" set:html={JSON.stringify(ldGraph)} />
