---
import { SITE_TITLE } from '../consts';

interface Props {
	current?: '/' | '/work' | '/writing' | '/now' | '/background';
}

const { current = '/' } = Astro.props;

const items = [
	{ href: '/work', label: 'Work' },
	{ href: '/writing', label: 'Writing' },
	{ href: '/now', label: 'Now' },
	{ href: '/background', label: 'Background' },
];
---

<header class="site-header">
	<a class="site-id" href="/">
		<img
			src="/avatar-128.png"
			srcset="/avatar-128.png 128w, /avatar.png 256w"
			sizes="40px"
			alt=""
			class="site-id-avatar"
			width="40"
			height="40"
			loading="eager"
			decoding="async"
		/>
		<span class="site-id-name">{SITE_TITLE}</span>
	</a>
	<nav class="site-nav" aria-label="Primary">
		{
			items.map((item) => (
				<a
					href={item.href}
					class:list={['site-nav-link', { active: current === item.href }]}
					aria-current={current === item.href ? 'page' : undefined}
				>
					{item.label}
				</a>
			))
		}
	</nav>
</header>
