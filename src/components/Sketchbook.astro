---
// Every route renders the whole sketchbook with one section open. Client-side,
// src/scripts/sketchbook.ts swaps sections in place and keeps the URL in sync.
import { sections, raxitMore, workMore, labs, openSource, careerLine, type SectionId } from '../data/sketchbook';
import { now } from '../data/now';
import { credentials } from '../data/background';
import { featuredWriting } from '../data/featured-writing';
import { recentWriting } from '../lib/recent';
import { formatRelativeDate } from '../lib/feeds';
import {
	SITE_TITLE,
	RAXIT_URL,
	RAXIT_LABS_URL,
	RAXIT_BLOG_URL,
	SUBSTACK_URL,
	LINKEDIN_URL,
	GITHUB_URL,
	EMAIL,
	CALENDAR_URL,
} from '../consts';

interface Props {
	active: SectionId;
}

const { active } = Astro.props;
const current = sections.find((s) => s.id === active) ?? sections[0];
const fullTitle = (title: string) => (title === SITE_TITLE ? title : `${title} · ${SITE_TITLE}`);

const recent = await recentWriting(5);
const posts =
	recent.length > 0
		? recent.map((p) => ({ title: p.title, url: p.url, when: formatRelativeDate(p.pubDate) }))
		: featuredWriting.map((p) => ({ title: p.title, url: p.url, when: p.date ?? '' }));

const bar = sections.filter((s) => s.label);
---

<div class="book" data-book data-active={active}>
	<canvas class="paper" data-paper aria-hidden="true"></canvas>
	<div class="card">
		<header class="top">
			<a class="mark" href="/" data-go="hello">adesh.</a>
			<button class="dot" type="button" data-dot aria-label="Shuffle colours">
				<canvas data-doodle="dot" aria-hidden="true"></canvas>
			</button>
		</header>

		<div class="stage" aria-hidden="true">
			<canvas data-stage data-doodle={current.drawing} data-career={JSON.stringify(careerLine)}></canvas>
		</div>

		<div class="panel">
			<main id="main" class="copy" tabindex="-1">
				<h1 class="sr" data-heading>{current.id === 'hello' ? SITE_TITLE : current.title}</h1>
				{
					sections.map((s) => (
						<section
							class="sect"
							data-section={s.id}
							data-path={s.path}
							data-drawing={s.drawing}
							data-title={fullTitle(s.title)}
							data-heading={s.id === 'hello' ? SITE_TITLE : s.title}
							aria-label={s.title}
							hidden={s.id !== active}
						>
							{s.lines.map((line) => (
								<p class="line">
									<span class="ghost">{line}</span>
									<span class="typed" aria-hidden="true" />
								</p>
							))}
							<button class="more" type="button" data-more aria-expanded="false">
								… more
							</button>
							<div class="detail">
								{s.id === 'hello' && (
									<div class="contact">
										<a class="oval" href={CALENDAR_URL}>
											<canvas data-doodle="oval" aria-hidden="true" />
											book 30 minutes
										</a>
										<nav class="elsewhere" aria-label="Elsewhere">
											<a href={LINKEDIN_URL}>linkedin ↗</a>
											<a href={GITHUB_URL}>github ↗</a>
											<a href={`mailto:${EMAIL}`}>{EMAIL}</a>
										</nav>
									</div>
								)}

								{s.id === 'raxit' && (
									<>
										{raxitMore.map((p) => <p>{p}</p>)}
										<p class="links">
											<a class="u" href={RAXIT_URL}>raxitlabs.com ↗</a>
										</p>
									</>
								)}

								{s.id === 'work' && (
									<>
										<ul class="list">
											{workMore.map((w) => (
												<li>
													<span>{w.text}</span>
													<span class="y">{w.year}</span>
												</li>
											))}
										</ul>
									</>
								)}

								{s.id === 'labs' && (
									<>
										<ul class="list projects">
											{labs.map((l) => (
												<li>
													<a href={l.url}>{l.title}</a>
													<span class="y">{l.when}</span>
													<span class="note">{l.note}</span>
												</li>
											))}
										</ul>
										<p>
											<span class="soft">also open source. </span>
											{openSource.map((r, i) => (<><a class="u" href={r.url}>{r.name}</a>{i < openSource.length - 1 ? ', ' : ''}</>))}
										</p>
										<p class="links">
											<a class="u" href={RAXIT_LABS_URL}>all of the labs ↗</a>
										</p>
									</>
								)}

								{s.id === 'writing' && (
									<>
										<ul class="list">
											{posts.map((p) => (
												<li>
													<a href={p.url}>{p.title}</a>
													<span class="y">{p.when}</span>
												</li>
											))}
										</ul>
										<p class="links">
											<a class="u" href={RAXIT_BLOG_URL}>everything on raxitlabs.com ↗</a>
											<a class="u" href={SUBSTACK_URL}>substack ↗</a>
										</p>
									</>
								)}

								{s.id === 'now' && (
									<>
										{now.more.map((p) => <p>{p}</p>)}
										<p class="soft">updated {now.updated.toLowerCase()}.</p>
									</>
								)}

								{s.id === 'about' && (
									<>
										<p>{credentials.certifications.join(', ')}.</p>
										<p class="soft">{credentials.recognition.join(', ')}. {credentials.education}.</p>
										<div class="contact">
											<a class="oval" href={CALENDAR_URL}>
												<canvas data-doodle="oval" aria-hidden="true" />
												book 30 minutes
											</a>
											<nav class="elsewhere" aria-label="Elsewhere">
												<a href={LINKEDIN_URL}>linkedin ↗</a>
												<a href={GITHUB_URL}>github ↗</a>
												<a href={`mailto:${EMAIL}`}>{EMAIL}</a>
											</nav>
										</div>
									</>
								)}
							</div>
						</section>
					))
				}
			</main>

			<nav class="bar" data-bar aria-label="Sections">
				{
					bar.map((s) => (
						<a href={s.path} data-go={s.id} aria-current={s.id === active ? 'page' : undefined}>
							{s.label}
						</a>
					))
				}
			</nav>
		</div>
	</div>
</div>

<script>
	import '../scripts/sketchbook';
</script>
