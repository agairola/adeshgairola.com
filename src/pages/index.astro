---
import Page from '../layouts/Page.astro';
import { fetchFeed, mergeAndDedupe, formatRelativeDate } from '../lib/feeds';
import { now } from '../data/now';
import { homeTestimonial } from '../data/testimonials';
import {
	SUBSTACK_URL,
	SUBSTACK_FEED_URL,
	RAXIT_BLOG_URL,
	RAXIT_FEED_URL,
	LINKEDIN_URL,
	GITHUB_URL,
	EMAIL,
	CALENDAR_URL,
} from '../consts';

// Recent writing: always dynamic, pulled at build time from raxIT Labs + Substack.
const [raxitItems, substackItems] = await Promise.all([
	fetchFeed(RAXIT_FEED_URL, 'raxIT', RAXIT_BLOG_URL),
	fetchFeed(SUBSTACK_FEED_URL, 'Substack', SUBSTACK_URL),
]);
const recent = mergeAndDedupe(raxitItems, substackItems).slice(0, 3);
---

<Page current="/" hideHeader>
	<div class="hero">
		<img
			src="/avatar.png"
			srcset="/avatar-128.png 128w, /avatar.png 256w"
			sizes="72px"
			alt="Adesh Gairola"
			class="avatar"
			width="72"
			height="72"
			loading="eager"
			decoding="async"
		/>
		<div class="hero-text">
			<h1>Adesh Gairola</h1>
			<p class="tagline">Security is a habit, not a project.</p>
		</div>
	</div>

	<p class="identity">
		Founder of <a href="https://raxitlabs.com">raxIT Labs</a>. Fifteen years
		building security into systems that move fast: network, cloud, now AI.
		Ex-AWS Security. Sydney.
	</p>

	<p class="locale">
		Sydney · <time
			id="local-time"
			aria-live="polite"
			aria-atomic="true"
			data-static="Loading…">Loading…</time
		>
	</p>

	<nav class="hub-nav" aria-label="Primary">
		<a href="/work">Work</a>
		<span class="dot" aria-hidden="true">·</span>
		<a href="/writing">Writing</a>
		<span class="dot" aria-hidden="true">·</span>
		<a href="/now">Now</a>
		<span class="dot" aria-hidden="true">·</span>
		<a href="/background">Background</a>
	</nav>

	<div class="rule" aria-hidden="true"><span>◇</span><span>◇</span><span>◇</span></div>

	<h2 class="eyebrow"><span class="eyebrow-num">01</span> Now</h2>
	<p class="now-snapshot">{now.snapshot}</p>
	<p class="meta"><a href="/now">More on /now →</a></p>

	<figure class="testimonial-pullquote">
		<blockquote>“{homeTestimonial.quote}”</blockquote>
		<figcaption>
			<span class="cite-role">{homeTestimonial.role}</span>
		</figcaption>
	</figure>

	<h2 class="eyebrow"><span class="eyebrow-num">02</span> Recent writing</h2>
	{
		recent.length > 0 ? (
			<ul class="bare writing">
				{recent.map((p) => (
					<li>
						<a class="bracket-title" href={p.url}>
							{p.title}
						</a>
						<span class="writing-date">
							<time datetime={p.pubDate.toISOString()}>{formatRelativeDate(p.pubDate)}</time>
						</span>
					</li>
				))}
			</ul>
		) : (
			<p class="meta">
				Feeds didn't load this build. Latest writing at <a href={RAXIT_BLOG_URL}>raxIT Labs</a> and{' '}
				<a href={SUBSTACK_URL}>Substack</a>.
			</p>
		)
	}
	<p class="meta"><a href="/writing">More writing →</a></p>

	<aside class="talk-cta">
		<p>
			Working on AI security and want a second pair of eyes? Building something
			and stuck on a threat-model question?
		</p>
		<p>
			<a class="talk-link" href={CALENDAR_URL}>Book 30 minutes →</a>
		</p>
	</aside>

	<p class="connect-inline">
		<a href={LINKEDIN_URL}>LinkedIn</a> <span aria-hidden="true">·</span>{' '}
		<a href={GITHUB_URL}>GitHub</a> <span aria-hidden="true">·</span>{' '}
		<a href={`mailto:${EMAIL}`}>{EMAIL}</a>
	</p>

	<script is:inline>
		(() => {
			const el = document.getElementById('local-time');
			if (!el) return;
			const fmt = new Intl.DateTimeFormat('en-AU', {
				timeZone: 'Australia/Sydney',
				hour: 'numeric',
				minute: '2-digit',
				hour12: true,
			});
			const tick = () => {
				const t = fmt.format(new Date());
				const tzPart = new Intl.DateTimeFormat('en-AU', {
					timeZone: 'Australia/Sydney',
					timeZoneName: 'short',
				})
					.formatToParts(new Date())
					.find((p) => p.type === 'timeZoneName');
				const tz = tzPart ? tzPart.value : 'AEST';
				el.textContent = `${t} ${tz}`;
			};
			let interval;
			function start() {
				tick();
				interval = setInterval(tick, 30_000);
			}
			function stop() {
				clearInterval(interval);
			}
			document.addEventListener('visibilitychange', () => {
				if (document.hidden) stop();
				else start();
			});
			start();
		})();
	</script>
</Page>
