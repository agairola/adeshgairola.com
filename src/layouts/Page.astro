---
import BaseHead from '../components/BaseHead.astro';
import Sketchbook from '../components/Sketchbook.astro';
import { sections, type SectionId } from '../data/sketchbook';

interface Props {
	section: SectionId;
}

const { section } = Astro.props;
const s = sections.find((x) => x.id === section) ?? sections[0];
---

<html lang="en-AU" class="no-js">
	<head>
		<BaseHead title={s.title} description={s.description} />
	</head>
	<body>
		<a class="skip-link" href="#main">skip to content</a>
		<Sketchbook active={section} />
	</body>
</html>
